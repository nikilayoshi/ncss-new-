{
  "version": 2,
  "functions": {
    "api/*.js": {
      "includeFiles": "node_modules/pdfkit/**"
    },
    "server.js": {
      "includeFiles": "node_modules/pdfkit/**"
    }
  },
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "public/**",
          "node_modules/pdfkit/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
